{
  "manifest_version": 2,
  "id": "github.hk560.github-subscriber",
  "name": "MaiBot GitHub Subscriber",
  "version": "1.2.1",
  "description": "订阅多个 GitHub 仓库的提交、Release、Issues、Pull Request 与标签变化，按分支和作者筛选后推送到手动填写的群聊或私聊；每个仓库可单独指定通知目标或继承全局配置。",
  "author": {
    "name": "HK560",
    "url": "https://github.com/HK560"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/HK560/Maibot-GitHub-Subscriber",
    "homepage": "https://github.com/HK560/Maibot-GitHub-Subscriber",
    "documentation": "https://github.com/HK560/Maibot-GitHub-Subscriber/blob/main/README.md",
    "issues": "https://github.com/HK560/Maibot-GitHub-Subscriber/issues"
  },
  "host_application": {
    "min_version": "1.3.17",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.98.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    }
  ],
  "capabilities": [
    "send.text",
    "send.forward",
    "chat.get_group_streams",
    "chat.get_private_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "integration",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "github",
      "fallback": "git-branch",
      "background": "#0D1117"
    }
  }
}
